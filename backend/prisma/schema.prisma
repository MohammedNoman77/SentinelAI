generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PERSONAL_USER EMPLOYEE SOC_ANALYST INCIDENT_RESPONDER SYSTEM_ADMIN
}
enum SourceType { EDR
  SIEM
  NETWORK
  IDENTITY
  CLOUD
  EMAIL
  ENDPOINT }
enum Severity { LOW
  MEDIUM
  HIGH
  CRITICAL }
enum EventStatus { NEW
  INVESTIGATING
  RESOLVED
  CLOSED
  FALSE_POSITIVE }
enum IncidentStatus { OPEN
  IN_PROGRESS
  INVESTIGATING
  CONTAINMENT
  RESOLVED
  CLOSED }
enum DeviceType { LAPTOP
  DESKTOP
  PHONE
  TABLET
  ROUTER
  OTHER }
enum DeviceStatus { ONLINE
  OFFLINE
  AT_RISK }
enum EventCategory { PROCESS
  NETWORK
  FILE
  AUTHENTICATION
  USB
  SYSTEM
  BROWSER }
enum AnomalyStatus { NEW
  CONFIRMED
  FALSE_POSITIVE
  REVIEWED }
enum AlertStatus { NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED }

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  name String
  nameAr String?
  role Role @default(EMPLOYEE)
  avatar String?
  phone String?
  isActive Boolean @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedIncidents Incident[] @relation("IncidentAssignee")
  investigations Investigation[] @relation("Investigator")
  generatedReports Report[] @relation("ReportGenerator")
  auditLogs AuditLog[]
  devices Device[]
  agentEvents SecurityEvent[] @relation("EventUser")
  anomalies Anomaly[]
  agentAlerts Alert[] @relation("AlertUser")
  recommendations Recommendation[]
  @@map("users")
}

model DataSource {
  id String @id @default(cuid())
  name String
  type SourceType
  description String?
  isActive Boolean @default(true)
  lastSync DateTime?
  createdAt DateTime @default(now())
  events SecurityEvent[]
  @@map("data_sources")
}

model SecurityEvent {
  id String @id @default(cuid())
  eventType String
  timestamp DateTime @default(now())
  severity Severity @default(LOW)
  status EventStatus @default(NEW)
  category EventCategory?
  title String
  description String?
  rawData Json?
  metadata Json?
  sourceIp String?
  destinationIp String?
  destinationPort Int?
  userEmail String?
  userAccount String?
  processName String?
  processPath String?
  processId Int?
  fileName String?
  sourceId String?
  source DataSource? @relation(fields: [sourceId], references: [id])
  deviceId String?
  device Device? @relation(fields: [deviceId], references: [id])
  userId String?
  user User? @relation("EventUser", fields: [userId], references: [id])
  alerts Alert[] @relation("AlertEvent")
  anomalies Anomaly[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([timestamp])
  @@index([severity])
  @@index([status])
  @@index([userId])
  @@index([deviceId])
  @@index([category])
  @@map("security_events")
}

model Incident {
  id String @id @default(cuid())
  incidentId String @unique
  title String
  description String?
  severity Severity
  status IncidentStatus @default(OPEN)
  sourceType SourceType?
  assignedTo String?
  assignee User? @relation("IncidentAssignee", fields: [assignedTo], references: [id])
  affectedDevice String?
  affectedUser String?
  maliciousIp String?
  fileHash String?
  threatType String?
  mitreTactic String?
  mitreTechnique String?
  detectedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  alerts Alert[]
  investigations Investigation[]
  evidence Evidence[]
  timeline TimelineEntry[]
  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model Alert {
  id String @id @default(cuid())
  title String
  description String?
  severity Severity
  status AlertStatus @default(NEW)
  category String?
  ruleId String?
  eventId String?
  event SecurityEvent? @relation("AlertEvent", fields: [eventId], references: [id])
  incidentId String?
  incident Incident? @relation(fields: [incidentId], references: [id])
  deviceId String?
  device Device? @relation(fields: [deviceId], references: [id])
  anomalyId String?
  anomaly Anomaly? @relation(fields: [anomalyId], references: [id])
  userId String?
  user User? @relation("AlertUser", fields: [userId], references: [id])
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([severity])
  @@index([status])
  @@index([userId])
  @@map("alerts")
}

model Investigation {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id])
  investigatorId String?
  investigator User? @relation("Investigator", fields: [investigatorId], references: [id])
  status String @default("in_progress")
  findings String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("investigations")
}
model Evidence {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id])
  type String
  description String?
  data Json?
  collectedAt DateTime @default(now())
  @@map("evidence")
}
model TimelineEntry {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id])
  time DateTime @default(now())
  title String
  description String?
  category String
  @@map("timeline_entries")
}
model Threat {
  id String @id @default(cuid())
  name String
  type String
  severity Severity
  source String?
  status String @default("detected")
  mitreTactic String?
  mitreTechnique String?
  description String?
  detectedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([severity])
  @@map("threats")
}
model Endpoint {
  id String @id @default(cuid())
  endpointId String @unique
  hostname String
  os String?
  ipAddress String?
  user String?
  status String @default("Protected")
  threatsCount Int @default(0)
  agentVersion String?
  lastSeen DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@map("endpoints")
}
model Report {
  id String @id @default(cuid())
  name String
  type String
  status String @default("completed")
  generatedBy String?
  generator User? @relation("ReportGenerator", fields: [generatedBy], references: [id])
  filePath String?
  fileSize Int?
  period String?
  createdAt DateTime @default(now())
  @@map("reports")
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id])
  action String
  resource String?
  details Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Device { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) name String type DeviceType @default(DESKTOP) os String? osVersion String? hostname String? ipAddress String? macAddress String? status DeviceStatus @default(OFFLINE) riskScore Int @default(0) apiKey String @unique agentInstalled Boolean @default(false) agentVersion String? lastHeartbeat DateTime? lastSeen DateTime @default(now()) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt events SecurityEvent[] anomalies Anomaly[] alerts Alert[] recommendations Recommendation[] @@index([userId]) @@map("devices") }
model BehaviorBaseline { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) deviceId String device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade) metric String avgValue Float minValue Float? maxValue Float? stdDev Float @default(0) sampleCount Int @default(0) timeWindow String @default("24h") lastUpdated DateTime @default(now()) createdAt DateTime @default(now()) @@unique([deviceId, metric]) @@map("behavior_baselines") }
model Anomaly { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) deviceId String device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade) eventId String? event SecurityEvent? @relation(fields: [eventId], references: [id]) title String description String score Int @default(0) severity Severity @default(MEDIUM) metric String? expectedValue Float? actualValue Float? deviation Float? context Json? status AnomalyStatus @default(NEW) detectedAt DateTime @default(now()) createdAt DateTime @default(now()) alerts Alert[] @@index([userId]) @@index([deviceId]) @@index([status]) @@map("anomalies") }
model Recommendation { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id], onDelete: Cascade) deviceId String? device Device? @relation(fields: [deviceId], references: [id]) title String description String priority Severity @default(MEDIUM) category String? isCompleted Boolean @default(false) isDismissed Boolean @default(false) completedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId]) @@map("recommendations") }
