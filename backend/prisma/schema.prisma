generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DeviceStatus { ONLINE OFFLINE AT_RISK }
enum DeviceType { LAPTOP DESKTOP PHONE TABLET ROUTER OTHER }
enum EventCategory { PROCESS NETWORK FILE AUTHENTICATION USB SYSTEM BROWSER }
enum Severity { LOW MEDIUM HIGH CRITICAL }
enum AnomalyStatus { NEW CONFIRMED FALSE_POSITIVE }
enum AlertStatus { NEW ACKNOWLEDGED RESOLVED DISMISSED }

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  name String
  enrollToken String @unique @map("enroll_token")
  isActive Boolean @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  devices Device[]
  events SecurityEvent[]
  anomalies Anomaly[]
  alerts Alert[]
  recommendations Recommendation[]
  @@map("users")
}

model Device {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostname String
  name String
  type DeviceType @default(DESKTOP)
  os String?
  osVersion String? @map("os_version")
  architecture String?
  ipAddress String? @map("ip_address")
  macAddress String? @map("mac_address")
  cpuCores Int? @map("cpu_cores")
  totalRam BigInt? @map("total_ram")
  diskSize BigInt? @map("disk_size")
  username String?
  status DeviceStatus @default(OFFLINE)
  riskScore Int @default(0) @map("risk_score")
  apiKeyHash String @unique @map("api_key_hash")
  agentVersion String? @map("agent_version")
  lastSeen DateTime? @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  events SecurityEvent[]
  anomalies Anomaly[]
  alerts Alert[]
  recommendations Recommendation[]
  baseline Baseline?
  @@unique([userId, hostname])
  @@index([userId])
  @@map("devices")
}

model SecurityEvent {
  id String @id @default(cuid())
  userId String @map("user_id")
  deviceId String @map("device_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  category EventCategory
  eventType String @map("event_type")
  severity Severity @default(LOW)
  title String
  description String?
  processName String? @map("process_name")
  processId Int? @map("process_id")
  sourceIp String? @map("source_ip")
  destinationIp String? @map("destination_ip")
  destinationPort Int? @map("destination_port")
  metadata Json?
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")
  anomalies Anomaly[]
  @@index([deviceId, timestamp])
  @@index([deviceId, eventType, timestamp])
  @@index([userId, timestamp])
  @@map("security_events")
}

model Anomaly {
  id String @id @default(cuid())
  userId String @map("user_id")
  deviceId String @map("device_id")
  eventId String? @map("event_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event SecurityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title String
  description String
  severity Severity
  score Int
  status AnomalyStatus @default(NEW)
  metric String
  indicator String
  detectedAt DateTime @default(now()) @map("detected_at")
  alerts Alert[]
  @@index([userId, detectedAt])
  @@index([deviceId, metric, indicator, detectedAt])
  @@map("anomalies")
}

model Alert {
  id String @id @default(cuid())
  userId String @map("user_id")
  deviceId String @map("device_id")
  anomalyId String? @map("anomaly_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  anomaly Anomaly? @relation(fields: [anomalyId], references: [id], onDelete: SetNull)
  title String
  description String
  severity Severity
  status AlertStatus @default(NEW)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([userId, status])
  @@map("alerts")
}

model Recommendation {
  id String @id @default(cuid())
  userId String @map("user_id")
  deviceId String? @map("device_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title String
  description String
  priority Severity @default(MEDIUM)
  isCompleted Boolean @default(false) @map("is_completed")
  isDismissed Boolean @default(false) @map("is_dismissed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([userId])
  @@map("recommendations")
}

model Baseline {
  id String @id @default(cuid())
  deviceId String @unique @map("device_id")
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  samples Int @default(0)
  mean Float @default(0)
  m2 Float @default(0)
  hourCounts Json @map("hour_counts")
  lastSampleAt DateTime? @map("last_sample_at")
  @@map("baselines")
}
